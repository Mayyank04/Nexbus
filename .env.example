# NEXBUS Environment Configuration Template
# National Capital Territory of Delhi Urban Mobility Intelligence Platform

# Application Environment
NODE_ENV=development
PORT=3000

# Base URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Operational Safety Invariant
# MUST remain READ_ONLY_PASSIVE. Automated physical actuation is strictly prohibited.
NEXBUS_SAFETY_MODE=READ_ONLY_PASSIVE

# Civic Privacy & Data Governance (k-anonymity & spatial truncation)
NEXBUS_K_ANONYMITY_THRESHOLD=15
NEXBUS_COORDINATE_PRECISION_DECIMALS=4

# Rate Limiting & Telemetry Polling
NEXBUS_RATE_LIMIT_PER_MIN=120
NEXBUS_TELEMETRY_POLL_INTERVAL_MS=15000

# Optional Internal CI/CD Test Secret (Must be >= 32 characters in production)
# In production, rate limits can ONLY be bypassed if this secret is set and matches the request header.
# NEXBUS_INTERNAL_TEST_SECRET=replace_with_secure_32_char_random_token_for_ci_runner

# Cache & Storage Timeouts
NEXBUS_HISTORICAL_CACHE_TTL_SEC=3600

# Map & Digital Twin Viewport Defaults (Delhi National Capital Territory)
NEXT_PUBLIC_MAP_DEFAULT_LAT=28.6139
NEXT_PUBLIC_MAP_DEFAULT_LON=77.2090
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=11
